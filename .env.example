MUSIC_API_PORT=5080
MUSIC_API_JWT_KEY=replace-with-at-least-32-random-characters
MUSIC_API_ADMIN_USERNAME=admin
MUSIC_API_ADMIN_PASSWORD=replace-with-a-strong-random-password
# 生产 Compose 必填：后端主机上的现有音乐目录，只读挂载到容器 /music。
MUSIC_SERVER_LIBRARY_PATH=C:/Music
# CORS 白名单（可选）。未设置时仅允许本机回环地址（localhost/127.0.0.1/[::1]）
# 的浏览器访问；需要从其他设备的浏览器（Flutter Web）访问 API 时填写完整来源。
# MUSIC_API_CORS_ORIGIN_0=http://192.168.1.10:8080
# MUSIC_API_CORS_ORIGIN_1=https://music.example.com
MUSIC_API_CPU_LIMIT=1.0
MUSIC_API_MEMORY_LIMIT=512m
MUSIC_SIDECAR_CPU_LIMIT=2.0
MUSIC_SIDECAR_MEMORY_LIMIT=1g
ONLINE_MUSIC_SOURCE_0=
ONLINE_MUSIC_SOURCE_1=
ONLINE_MUSIC_SOURCE_2=

# 生产编排 compose.online-music.production.yml 专用。
# 上线前把来源留空；只有 docs/online_music_release_review.md 的逐来源审批通过后才能启用。
MUSIC_DOMAIN=music.example.com
ACME_EMAIL=ops@example.com
ONLINE_MUSIC_ENABLED=false
PROMETHEUS_RETENTION=30d
# 指向仓库外已复核的 Alertmanager 配置；可先复制 deploy/observability/alertmanager.example.yml。
ALERTMANAGER_CONFIG_PATH=C:/secure/simulgroove/alertmanager.yml
