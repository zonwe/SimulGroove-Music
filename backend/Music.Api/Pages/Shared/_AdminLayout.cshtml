<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · SimulGroove Music</title>
    <link rel="stylesheet" href="~/admin/scanning/styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
        <a class="brand" asp-page="/Admin/Scanning/Index" aria-label="SimulGroove Music 管理后台首页">
            <span class="brand-mark" aria-hidden="true">SG</span>
            <span>
                <strong>SimulGroove Music</strong>
                <small>服务器管理后台</small>
            </span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="account-menu">
                <span class="account-name">@User.Identity.Name</span>
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout">
                    <button class="button button-quiet" type="submit">退出登录</button>
                </form>
            </div>
        }
    </header>
    <main id="main-content">
        @RenderBody()
    </main>
</body>
</html>
