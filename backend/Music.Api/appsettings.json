{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "storage/music.db"
  },
  "Auth": {
    "Issuer": "flutter-music-api",
    "Audience": "flutter-music-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Administration": {
    "Username": "admin",
    "Password": ""
  },
  "Scanning": {
    "PollSeconds": 30,
    "AllowedRoots": []
  },
  "Audit": {
    "RetentionDays": 90
  }
}
