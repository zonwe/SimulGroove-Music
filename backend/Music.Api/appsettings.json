{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "storage/music.db"
  },
  "Auth": {
    "Issuer": "flutter-music-api",
    "Audience": "flutter-music-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Administration": {
    "Username": "admin",
    "Password": ""
  },
  "Scanning": {
    "PollSeconds": 30,
    "AllowedRoots": []
  },
  "Audit": {
    "RetentionDays": 90
  },
  "OnlineMusic": {
    "Enabled": false,
    "SidecarBaseUrl": "http://127.0.0.1:8080",
    "RequestTimeoutSeconds": 12,
    "SearchCacheSeconds": 60,
    "RequestsPerMinute": 30,
    "PlaybackTicketSeconds": 300,
    "AllowedSources": [],
    "MaxResults": 50
  }
}
