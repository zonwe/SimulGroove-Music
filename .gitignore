# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
.vscode
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Workspace-local SDK and package caches
/.dart-appdata/
/.dart-localappdata/
/.nuget/

# Local environment and secret overrides
.env
.env.*
!.env.example

# .NET backend build and test artifacts
backend/**/bin/
backend/**/obj/
backend/**/TestResults/
backend/**/*.user
backend/**/*.suo
backend/**/*.trx

# Music.Api runtime SQLite database and sidecar files
backend/Music.Api/storage/music.db*

# The go-music-dl integration is maintained as a separate pinned clone.
/go-music-dl/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
