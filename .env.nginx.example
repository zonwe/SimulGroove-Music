# compose.online-music.nginx.yml 的环境模板（Nginx 反代部署）。
# 用法：复制为 .env 并替换全部占位值；.env 已在 .gitignore 中，不要提交。
#
# 生成密钥示例：
#   openssl rand -base64 48      # MUSIC_API_JWT_KEY（必须 >= 32 字节）
#   openssl rand -base64 24      # MUSIC_API_ADMIN_PASSWORD

# 后端域名，必须与 Nginx server_name 完全一致。
MUSIC_DOMAIN=music.example.com
# 允许的 Host 头（分号分隔）。包含 127.0.0.1 是为了让容器内 healthcheck 通过；
# 若省略该项（默认 *）则不做主机白名单校验。
MUSIC_ALLOWED_HOSTS=music.example.com;127.0.0.1

# Nginx 反向代理指向的宿主机回环端口。
MUSIC_API_HOST_PORT=5080

# 必填密钥。
MUSIC_API_JWT_KEY=replace-with-at-least-32-random-bytes
MUSIC_API_ADMIN_USERNAME=admin
MUSIC_API_ADMIN_PASSWORD=replace-with-a-strong-random-password

# 服务器扫描目录（宿主机绝对路径），只读挂载到容器 /music。
# 必须是已存在的专用目录，不能填 / 或文件系统根，也不能是符号链接。
MUSIC_SERVER_LIBRARY_PATH=/srv/simulgroove/library

# 在线音乐默认关闭。启用前必须完成逐来源授权复核并把来源 ID 填入白名单。
ONLINE_MUSIC_ENABLED=false
ONLINE_MUSIC_SOURCE_0=
ONLINE_MUSIC_SOURCE_1=
ONLINE_MUSIC_SOURCE_2=

# CORS 白名单（可选）。Flutter Web 与 API 同域时留空即可。
MUSIC_API_CORS_ORIGIN_0=
MUSIC_API_CORS_ORIGIN_1=
MUSIC_API_CORS_ORIGIN_2=

# 资源限额。
MUSIC_API_CPU_LIMIT=1.0
MUSIC_API_MEMORY_LIMIT=512m
MUSIC_SIDECAR_CPU_LIMIT=2.0
MUSIC_SIDECAR_MEMORY_LIMIT=1g
